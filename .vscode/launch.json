{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Vertex Education",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+https?://(?:localhost|127\\.0\\.0\\.1):([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
